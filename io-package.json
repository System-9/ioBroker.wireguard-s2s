  "native": {
    "interfaceName": "iowg0",
    "localAddresses": "10.200.0.1/30",
    "localNetworks": "192.168.1.0/24",
    "remoteNetworks": "10.200.0.2/32, 192.168.2.0/24",
    "privateKey": "",
    "localPublicKey": "",
    "listenPort": 51820,
    "peerPublicKey": "",
    "peerPresharedKey": "",
    "endpointHost": "",
    "endpointPort": 51820,
    "persistentKeepalive": 25,
    "mtu": 1420,
    "enableIPv4Forwarding": true,
    "enableIPv6Forwarding": false,
    "autoApply": false,
    "pollInterval": 15,
    "handshakeTimeout": 180
  },
  "protectedNative": [
    "privateKey",
    "peerPresharedKey"
  ],
  "encryptedNative": [
    "privateKey",
    "peerPresharedKey"
  ],
